# copie pra .env e preencha. o .env nunca vai pro git.

# --- obrigatório ---
LASTFM_API_KEY=coloque-sua-chave-aqui

# --- banco ---
DATABASE_URL=sqlite:///garimpo.db

# --- ambiente: dev ou prod ---
AMBIENTE=dev

# --- last.fm ---
LASTFM_REQ_POR_SEGUNDO=4
CACHE_ARTISTA_DIAS=14

# --- motor de descoberta ---
FANOUT=30
PONTES_POR_SEMENTE=6
DECAIMENTO_SALTO=0.85
PISO_OUVINTES=1000
TETO_OUVINTES=200000
EXPOENTE_RARIDADE=0.7
EXPOENTE_COERENCIA=0.5

# --- auth ---
# argon2id: os padrões seguem a RFC 9106 (64 MiB por hash).
# só mexa se souber o que está fazendo — mais baixo = mais fácil de quebrar.
ARGON2_TEMPO=3
ARGON2_MEMORIA_KIB=65536
ARGON2_PARALELISMO=4

SESSAO_VALIDADE_DIAS=30
